* text=auto
*.java text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.py text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.wav binary
*.jar binary
# Preserve the original CI evidence bytes covered by the SHA256 manifests.
docs/verification/**/*.png binary
docs/verification/**/*.txt -text
docs/verification/**/environment.json -text
docs/verification/**/*.xml -text

# Keep vendored upstream bytes identical to the pinned source hashes.
third_party/phosphor/** -text
app/src/main/assets/licenses/* -text
third_party/phosphor/manifest.json text eol=lf

# Retain the verified audio model, labels and Apache notice byte-for-byte.
third_party/yamnet/** -text
app/src/main/assets/yamnet.tflite binary

# Raw PCM fixtures belong only to the instrumentation test APK.
*.pcm binary

# Preserve actual classifier scores and fixture metadata as emitted by CI.
docs/verification/**/analysis-human-fixture-evaluation.json -text
docs/verification/**/analysis-category-fixture-evaluation.json -text

# Preserve bundled object model and metadata source hashes on Windows.
app/src/main/assets/object_efficientnet_lite0.tflite binary
app/src/main/assets/object_labels.txt -text
app/src/main/assets/object_model_LICENSE.txt -text
app/src/main/assets/object_model_PROVENANCE.json -text
