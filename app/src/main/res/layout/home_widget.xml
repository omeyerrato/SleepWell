<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/home_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:fontFamily="@font/inter_widget" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="SleepWell" android:textColor="#F9F1FF" android:textSize="18sp" />
        <!-- RemoteViews inflates framework ImageButtons in the host; app:tint has no AppCompat inflater here. -->
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_phosphor_arrow_counter_clockwise_regular" android:tint="#E3CAFF" tools:ignore="UseAppTint" android:padding="12dp" android:background="@android:color/transparent" android:contentDescription="Refresh SleepWell widget" />
        <ImageButton android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_phosphor_gear_six_fill" android:tint="#E3CAFF" tools:ignore="UseAppTint" android:padding="12dp" android:background="@android:color/transparent" android:contentDescription="Widget and shortcut settings" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_alarm" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="74dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/home_widget_card" android:padding="12dp" android:focusable="true">
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/widget_alarm_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Next alarm" android:textColor="#E3CAFF" android:textSize="12sp" android:maxLines="1" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/widget_alarm_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open SleepWell" android:textColor="#FFFFFF" android:textSize="26sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/widget_alarm_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh to load saved alarms" android:textColor="#E3CAFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_report" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="70dp" android:layout_marginTop="8dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/home_widget_card" android:focusable="true">
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/widget_report_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Last sleep record" android:textColor="#E3CAFF" android:textSize="12sp" android:maxLines="1" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/widget_report_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open history" android:textColor="#FFFFFF" android:textSize="22sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/widget_report_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh to load saved records" android:textColor="#E3CAFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <Button android:fontFamily="@font/inter_widget" android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Add alarm" android:textAllCaps="false" android:textColor="#261D31" android:textSize="14sp" android:background="@drawable/home_widget_button" android:contentDescription="Open Add alarm editor" />
</LinearLayout>
